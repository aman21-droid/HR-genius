# Copy to .env and adjust for your environment. docker-compose reads these automatically.

# ---- Oracle ----
ORACLE_SYS_PASSWORD=oracle
DB_USERNAME=hrgenius
DB_PASSWORD=hrgenius

# ---- Security (CHANGE THESE IN PRODUCTION) ----
# JWT signing secret must be at least 32 bytes for HS256.
JWT_SECRET=change-me-in-prod-this-must-be-at-least-32-bytes-long-secret
# AES key for sensitive-field encryption at rest (PAN, Aadhaar/SSN, bank account).
FIELD_ENCRYPTION_KEY=dev-only-256-bit-field-encryption-key-01

# ---- Token lifetimes (optional overrides, milliseconds) ----
# ACCESS_TOKEN_TTL_MS=900000       # 15 min
# REFRESH_TOKEN_TTL_MS=604800000   # 7 days
